[Unit]
Description=Project Archangel control plane
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/opt/archangel/archangeld -config /etc/archangel/config.yaml
Restart=on-failure
RestartSec=5
User=archangel
Group=archangel

# Resource limits - OS-level backstop for the in-app watchdog (Milestone 3):
# if the watchdog itself misbehaves, systemd is still the last line of
# defense against this process eating the whole 1GB box.
MemoryMax=150M
MemoryHigh=120M
CPUQuota=50%
TasksMax=100

# Hybrid Cockpit model: the daemon runs as 'archangel' for least-privilege
# separation, but is granted passwordless sudo in /etc/sudoers.d/archangel
# so administrative commands in the terminal (apt upgrade, systemctl, etc.)
# succeed.
#
# PrivateTmp provides an isolated, writable /tmp namespace so tools like tmux
# and compilers work without exposing tmp files to other processes.
# ProtectSystem=full protects /usr and /boot as read-only for unprivileged
# execution, while allowing normal writes to /home/archangel and /tmp.
NoNewPrivileges=false
ProtectSystem=full
PrivateTmp=true
WorkingDirectory=/home/archangel
ReadWritePaths=/home/archangel /opt/archangel /srv/deploy
ReadOnlyPaths=/etc/archangel

[Install]
WantedBy=multi-user.target
